<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.pan.dashstyle</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>DashStyle CSS Module Support</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/robertpanvip/dashstyle">pan</vendor>
    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
<p>Enhances IntelliJ IDEA with better support for CSS Modules, specifically targeting string-key access like <code>styles["foo-bar"]</code>.</p>

<p>Key features:</p>
<ul>
  <li><strong>Code completion</strong>: Auto-complete class names from imported CSS Modules inside <code>styles["</code> (in kebab-case), with the corresponding camelCase name shown next to each suggestion.</li>
  <li><strong>Navigation</strong>: Ctrl+click on <code>"foo-bar"</code> jumps directly to the matching <code>.foo-bar</code> ruleset in the CSS file, or to the <code>fooBar</code> property in a local object definition.</li>
  <li><strong>Smart quote handling</strong>: After completion, automatically inserts the matching closing quote and places the cursor inside the quotes.</li>
  <li>Supports both imported CSS/SCSS/LESS files (CSS Modules) and locally defined JS/TS objects.</li>
</ul>

<p>Ideal for React, Vue, or any project using CSS Modules — brings full IDE intelligence to kebab-case class names used in string literals.</p>
]]></description>

    <change-notes>
        <![CDATA[
        <h3>1.3.0</h3>
        <ul>
            <li>🗑️ 移除 Flex/Grid 布局可视化预览（gutter LineMarker + 交互弹窗）及对应测试</li>
            <li>🗑️ 移除阴影预览（box-shadow / text-shadow gutter 预览）及对应测试</li>
            <li>🗑️ 移除全局 HighlightVisitor（StaticGlobalHighlightVisitor），避免干扰 TypeScript/JavaScript 高亮</li>
            <li>🔧 Java target 升级至 21；修复选择器展开缓存的失效范围，外部修改文件后不再被覆盖</li>
        </ul>

        <h3>1.2.7</h3>
        <ul>
            <li>🗑️ 移除以下功能，插件回归聚焦核心能力：<code>styles.xxx</code> 智能跳转/补全、Inline Style 抽取、JSON→CSS 复制粘贴、代码检查、布局/阴影预览、Tailwind 补全：</li>
            <ul>
                <li>移除 CSS Module 导入自动化（含复制时自动带 import）</li>
                <li>移除 TSX/Vue 复制 → CSS 规则随动</li>
                <li>移除 SCSS / LESS / 原生 CSS Nesting 互转（Intention Action）</li>
                <li>移除项目公共颜色 → CSS Variable 抽取（AnAction）</li>
                <li>移除 CSS 尺寸/单位换算助手（Inlay）</li>
            </ul>
        </ul>

        <h3>1.2.0</h3>
        <ul>
            <li>✨ 新增 <code>styles.fooBar</code> member access 跳转/补全（此前仅支持 <code>styles["foo-bar"]</code>）</li>
            <li>✨ 鼠标悬浮 CSS Module class，显示展开后的完整规则声明（含 kebab 选择器、声明列表、来源位置）</li>
            <li>✨ 未使用的 CSS Module class 自动置灰，Alt+Enter 可直接删除（遇动态 <code>styles[expr]</code> 自动关闭，不误报）</li>
            <li>✨ 缺失 class 快速创建：<code>styles.xxx</code> 解析失败时 Alt+Enter，在对应 CSS Module 末尾生成空 class 并把光标定位到大括号内</li>
            <li>✨ 单文件重复 CSS 声明检测（变黄 + 波浪线），一键抽取公共类并生成 <code>@extend</code> 回所有重复点（SCSS/LESS）</li>
        </ul>

        <h3>1.0.8</h3>
        <ul>
            <li>✨ 支持 LESS / SCSS 嵌套规则（nested rulesets）</li>
            <li>✨ 支持 &-xxx / &__xxx 选择器解析</li>
            <li>🐛 修复嵌套 class 无法跳转的问题</li>
        </ul>

        <h3>1.1.0</h3>
        <ul>
            <li>初始版本</li>
        </ul>
        ]]>
    </change-notes>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xml</depends>
    <!-- CSS 插件（WebStorm / IDEA Ultimate / PyCharm Pro 内置）。
         历史上的 "com.intellij.modules.css-openapi" 已在 2023.3+ 被拆分废弃，
         2025.3 现代版本的 bundled plugin ID 统一是 "com.intellij.css"，
         否则本地安装会弹「需要安装 com.intellij.modules.css-openapi 模块」的提示。-->
    <depends>com.intellij.css</depends>
    <depends>JavaScript</depends>
    <depends optional="true">org.jetbrains.plugins.vue</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- ========================= Tailwind 类补全（@apply 内，右侧 CSS 预览） ========================= -->
        <!-- 在 CSS 的 @apply 指令内对 Tailwind 类做补全，候选右侧灰字显示该类展开后的 CSS 声明，
             按 Enter 直接补全。类清单来自 TailwindClassResolver（纯逻辑，内置常用类）。 -->
        <completion.contributor
                language="CSS"
                implementationClass="com.pan.dashstyle.TailwindClassCompletionContributor"/>
        <completion.contributor
                language="SCSS"
                implementationClass="com.pan.dashstyle.TailwindClassCompletionContributor"/>
        <completion.contributor
                language="LESS"
                implementationClass="com.pan.dashstyle.TailwindClassCompletionContributor"/>

        <!-- ========================= 引用 & 跳转 ========================= -->
        <psi.referenceContributor
                implementation="com.pan.dashstyle.StyleStringKeyReferenceContributor"/>

        <!-- styles.xxx member access 也能跳转/补全 -->
        <psi.referenceContributor
                implementation="com.pan.dashstyle.StyleMemberAccessReferenceContributor"/>

        <!-- ========================= 悬浮文档（#4） ========================= -->
        <lang.documentationProvider
                language="CSS"
                implementationClass="com.pan.dashstyle.DashStyleDocumentationProvider"
                order="first"/>
        <lang.documentationProvider
                language="JavaScript"
                implementationClass="com.pan.dashstyle.DashStyleDocumentationProvider"
                order="first"/>
        <lang.documentationProvider
                language="TypeScript"
                implementationClass="com.pan.dashstyle.DashStyleDocumentationProvider"
                order="first"/>
        <lang.documentationProvider
                language="TypeScript JSX"
                implementationClass="com.pan.dashstyle.DashStyleDocumentationProvider"
                order="first"/>
        <lang.documentationProvider
                language="SCSS"
                implementationClass="com.pan.dashstyle.DashStyleDocumentationProvider"
                order="first"/>
        <lang.documentationProvider
                language="LESS"
                implementationClass="com.pan.dashstyle.DashStyleDocumentationProvider"
                order="first"/>

        <!-- ========================= 代码检查（#1 未使用 class / #2 重复 declarations） ========================= -->
        <!-- 注意：<localInspection> 的 shortName 在整个插件里必须唯一（哪怕 implementationClass / language 不同）。
             下面按语言维度分别赋予唯一 shortName；Kotlin 侧 Inspection 类不再 override getShortName()，
             直接继承 LocalInspectionTool 默认返回 XML 声明的 shortName，避免代码与 XML 漂移。
             另：SCSS/LESS 的官方 language id 在不同发行版里常出现 id 不匹配（如 SCSS 插件没启用、LESS id 变成 Less），
             因此增加 language="ANY" 兜底注册 → 所有文件的 PSI 遍历都会激活我们的 inspection，
             具体要不要处理，Kotlin 代码里会通过 CssRuleset / file suffix 判断，不影响其他语言。-->
        <localInspection
                language="CSS"
                displayName="Unused CSS Module class"
                groupName="DashStyle"
                shortName="DashStyle.UnusedCssClass.Css"
                enabledByDefault="true"
                level="WEAK WARNING"
                implementationClass="com.pan.dashstyle.UnusedCssModuleClassInspection"/>
        <localInspection
                language="SCSS"
                displayName="Unused CSS Module class"
                groupName="DashStyle"
                shortName="DashStyle.UnusedCssClass.Scss"
                enabledByDefault="true"
                level="WEAK WARNING"
                implementationClass="com.pan.dashstyle.UnusedCssModuleClassInspection"/>
        <localInspection
                language="LESS"
                displayName="Unused CSS Module class"
                groupName="DashStyle"
                shortName="DashStyle.UnusedCssClass.Less"
                enabledByDefault="true"
                level="WEAK WARNING"
                implementationClass="com.pan.dashstyle.UnusedCssModuleClassInspection"/>
        <localInspection
                language="ANY"
                displayName="Unused CSS Module class (fallback)"
                groupName="DashStyle"
                shortName="DashStyle.UnusedCssClass.Any"
                enabledByDefault="true"
                level="WEAK WARNING"
                implementationClass="com.pan.dashstyle.UnusedCssModuleClassInspection"/>
        <localInspection
                language="CSS"
                displayName="Duplicate CSS declarations (single file)"
                groupName="DashStyle"
                shortName="DashStyle.DuplicateCss.Css"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.pan.dashstyle.DuplicateCssDeclarationsInspection"/>
        <localInspection
                language="SCSS"
                displayName="Duplicate CSS declarations (single file)"
                groupName="DashStyle"
                shortName="DashStyle.DuplicateCss.Scss"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.pan.dashstyle.DuplicateCssDeclarationsInspection"/>
        <localInspection
                language="LESS"
                displayName="Duplicate CSS declarations (single file)"
                groupName="DashStyle"
                shortName="DashStyle.DuplicateCss.Less"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.pan.dashstyle.DuplicateCssDeclarationsInspection"/>
        <localInspection
                language="ANY"
                displayName="Duplicate CSS declarations (single file, fallback)"
                groupName="DashStyle"
                shortName="DashStyle.DuplicateCss.Any"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.pan.dashstyle.DuplicateCssDeclarationsInspection"/>

        <annotator language="CSS" implementationClass="com.pan.dashstyle.DashStyleHighlightAnnotator"/>
        <annotator language="SCSS" implementationClass="com.pan.dashstyle.DashStyleHighlightAnnotator"/>
        <annotator language="LESS" implementationClass="com.pan.dashstyle.DashStyleHighlightAnnotator"/>

        <!-- ========================= 复制粘贴处理器 ========================= -->
        <!-- 用户反馈：复制 `styles.xxx` → 粘贴到别处的场景，IntelliJ 平台自带「Add import on paste」已能自动补 import，
             所以移除 DashStyle 自己实现的 CssModuleImportCopyPasteProcessor（#3）避免两条逻辑冲突。-->
        <copyPastePreProcessor
                implementation="com.pan.dashstyle.JsonToCssCopyPastePreProcessor"/>

        <!-- ========================= 快速修复 / 意向动作 ========================= -->
        <!-- WebStorm 里 .ts 是 TypeScript、.tsx 是独立语言 TSX（.jsx 属于 JavaScript 方言），
             所以必须显式绑 JavaScript/TypeScript/TSX/XML，否则这些 intention 在 React TSX
             文件的 styles.xxx / style={{...}} 上永远不会出现在 Alt+Enter 列表里。-->
        <intentionAction>
            <className>com.pan.dashstyle.InlineStyleToCssModuleIntention</className>
            <language>JavaScript</language>
            <language>TypeScript</language>
            <language>TSX</language>
            <language>XML</language>
            <category>DashStyle</category>
            <description><![CDATA[
              Extracts the inline style object (<code>style={{ ... }}</code> in React/TSX
              or <code>:style=&quot;{ ... }&quot;</code> in Vue) into a CSS Module class.<br/>
              <ul>
                <li>Automatic semantic class name inference (from component name, siblings, and style property semantics).</li>
                <li>Rename-style input dialog lets you tweak the name before committing.</li>
                <li>Appends the rule to <code>&lt;style module&gt;</code> (.vue) or the imported
                    <code>*.module.css</code>/<code>.scss</code>/<code>.less</code> file.</li>
              </ul>
            ]]></description>
            <bindToCode>true</bindToCode>
        </intentionAction>

        <intentionAction>
            <className>com.pan.dashstyle.CreateMissingCssClassIntention</className>
            <language>JavaScript</language>
            <language>TypeScript</language>
            <language>TSX</language>
            <language>XML</language>
            <category>DashStyle</category>
            <description><![CDATA[
              When <code>styles.fooBar</code> or <code>styles["foo-bar"]</code> has no corresponding CSS class,
              creates <code>.foo-bar { }</code> at the end of the target CSS Module (or Vue
              <code>&lt;style module&gt;</code>) and places the caret inside the braces.
            ]]></description>
            <bindToCode>true</bindToCode>
        </intentionAction>

        <intentionAction>
            <className>com.pan.dashstyle.ExtractDuplicateDeclarationsAsMixinIntention</className>
            <language>CSS</language>
            <language>SCSS</language>
            <language>LESS</language>
            <language>XML</language>
            <category>DashStyle</category>
            <description><![CDATA[
              Scans the current CSS/SCSS/LESS file (or the selected portion) for
              rulesets sharing exactly the same declaration block body and
              factors them out into a single shared Less-style mixin (e.g.
              <code>.shared-padding { padding: 10px; }</code>), replacing each
              original ruleset's body with a mixin call (e.g.
              <code>.shared-padding;</code>). Nested blocks, strings and
              function calls like <code>linear-gradient(...)</code> /
              <code>url("...")</code> are preserved verbatim during comparison.
            ]]></description>
            <bindToCode>true</bindToCode>
        </intentionAction>
    </extensions>
</idea-plugin>
